# ---------- Bot API server (npm start) ----------
DATABASE_URL=postgres://tgbot:tgbot@localhost:5432/tgbot
# PORT=3000

EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# POLL_INTERVAL_MS=90000
# MAX_SEARCHES_PER_CHAT=5

# Optional shared secret between the bot and this API. If set here, set the
# same value in client/.env. Leave empty to keep the API open as before.
BACKEND_API_TOKEN=

# Timezone for "today" / "this month" in stats and daily activity
STATS_TIMEZONE=Europe/Kyiv
# Notification history and user errors older than this are deleted
HISTORY_RETENTION_DAYS=90

# ---------- Monetization (no real payments yet) ----------
# While false, plan limits are NOT applied and the bot behaves as before
PAYMENTS_ENABLED=false
# Enables the "mock" payment provider (ignored when NODE_ENV=production)
MOCK_PAYMENT_SECRET=

# ---------- Admin panel (npm run admin) ----------
ADMIN_PANEL_USER=admin
# Generate with: npm run admin:hash-password   (keep the single quotes)
ADMIN_PANEL_PASSWORD_HASH=''
# Random string, 32+ chars: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_PANEL_SESSION_SECRET=
ADMIN_PANEL_HOST=127.0.0.1
ADMIN_PANEL_PORT=3100
# auto = Secure cookie whenever the request arrived over HTTPS (via the proxy).
# Set to true in production behind an HTTPS reverse proxy.
ADMIN_PANEL_COOKIE_SECURE=auto
# Which proxies to trust for X-Forwarded-* (loopback = proxy on the same host)
ADMIN_PANEL_TRUST_PROXY=loopback
ADMIN_PANEL_SESSION_HOURS=8
ADMIN_PANEL_LOGIN_MAX_ATTEMPTS=10

# ---------- Tests (npm test) ----------
# Tests create and drop their own temporary schema in this database
TEST_DATABASE_URL=postgres://tgbot:tgbot@localhost:5432/tgbot
